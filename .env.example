# --- Supabase ---
# Los tomas de tu proyecto en https://app.supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# --- Base de datos (para Prisma) ---
# Usamos DOS conexiones distintas (patrón recomendado por Prisma+Supabase):
#
# DATABASE_URL: "Transaction pooler" (puerto 6543) — la usa la app en
# tiempo de ejecución. Maneja muchas conexiones cortas simultáneas mucho
# mejor que el modo Session, evitando el error "max clients reached".
# Consíguela en: Supabase -> tu proyecto -> Connect -> Transaction pooler.
# IMPORTANTE: agrégale "?pgbouncer=true" al final (ver ejemplo abajo).
DATABASE_URL=postgresql://postgres.tu-project-ref:tu-password@aws-0-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true

# DIRECT_URL: "Session pooler" (puerto 5432) — la usa Prisma SOLO para
# correr migraciones (`npx prisma migrate dev`). El modo Transaction no
# soporta los comandos que las migraciones necesitan.
# Consíguela en: Supabase -> tu proyecto -> Connect -> Session pooler.
DIRECT_URL=postgresql://postgres.tu-project-ref:tu-password@aws-0-us-east-2.pooler.supabase.com:5432/postgres

# --- TMDb ---
# Genera un "API Read Access Token" (v4 auth) en
# https://www.themoviedb.org/settings/api
TMDB_READ_ACCESS_TOKEN=tu-token-de-tmdb

# --- Anuncios (opcional) ---
# Si tienes una cuenta aprobada de Google AdSense, pon aquí tu ID de
# cliente (formato ca-pub-XXXXXXXXXXXXXXXX) para activar los anuncios
# reales. Si la dejas vacía o comentada, los espacios de anuncio se
# muestran como placeholders ("Publicidad" + dimensiones) — la app
# funciona igual, simplemente sin anuncios reales todavía.
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
